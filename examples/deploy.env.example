# ============================================================================
# S-UI 部署配置示例
#
# 用法：
#   cp examples/deploy.env.example deploy.env
#   $EDITOR deploy.env
#
# ⚠️ 填好后不要把 deploy.env 提交到任何仓库。
#    行内注释会被正确剥离：`ANYTLS_PORT=8443  # TCP` 解析为 8443。
# ============================================================================

# ---------------------------------------------------------------- 1. VPS 连接
VPS_HOST=203.0.113.10
VPS_PORT=22
VPS_USER=root
VPS_PASS=改成你的密码
# 用密钥时注释掉 VPS_PASS，填这一项：
# VPS_KEY=/path/to/id_rsa

# ---------------------------------------------------------------- 2. 域名与地址
# 必须已解析到 SERVER_IP，且 Cloudflare 下保持灰云（不代理）
DOMAIN=us.example.com
SERVER_IP=203.0.113.10

# 节点名前缀（inbound tag 的前半段，用户会在客户端里看到）
# 例：NODE_PREFIX=JP 生成 JP-AnyTLS-8443 / JP-Hysteria2-2083 / JP-Reality-2053 /
#     JP-Shadowsocks-2087（填了 TUIC_PORT 时还会多一个 JP-TUIC-8443）
# 留空默认 US。一个字符到几个字符都行，不要带空格或短横。
NODE_PREFIX=US

# ---------------------------------------------------------------- 3. 面板（S-UI）
SUI_VERSION=1.6.7
PANEL_USER=admin
# 留空则安装脚本随机生成 20 位
PANEL_PASS=
# 建议用非常用端口
PANEL_PORT=46821
# 留空则随机生成 16 位 hex
PANEL_PATH=
# 面板与订阅走 HTTPS（证书申请成功后自动生效）
PANEL_TLS=1

# ---------------------------------------------------------------- 4. 订阅
SUB_PORT=2096
# 留空则随机生成 16 位 hex
SUB_PATH=
# 订阅 ID，也是 URL 最后一段，可自定义
SUB_ID=us

# ---------------------------------------------------------------- 5. 节点端口
# ⚠️ 全部避开 443。实测 443 被针对性干扰：Reality 报认证失败、Hysteria2 全部 timeout，
#    而同样的配置换到 2053 / 2083 立刻恢复正常。详见 references/pitfalls.md §1。
ANYTLS_PORT=8443
HY2_PORT=2083
REALITY_PORT=2053

# TUIC 默认**留空 = 不部署**。实测在部分线路上被限速到 0.2~0.4 Mbps，
# 换端口（8443/2084）、换客户端（mihomo / sing-box 官方）都一样，见 pitfalls §6.8。
# 想开就填个端口号（注意 8443/udp 与 AnyTLS 的 8443/tcp 不冲突，是两套命名空间）。
TUIC_PORT=

# Shadowsocks 2022。留空 = 不部署。
# ⚠️ SS 入站默认同时监听 tcp 和 udp（UDP relay），防火墙两个都要放行；
#    setup_base.sh 会自动按这个端口写两条规则。
SS_PORT=2087
# 2022-blake3-aes-128-gcm（psk 16 字节）/ 2022-blake3-aes-256-gcm（32 字节）
# / 2022-blake3-chacha20-poly1305（32 字节）
SS_METHOD=2022-blake3-aes-128-gcm

# Hysteria2 端口跳跃范围（可选）。需要同时放行这段 UDP 并配 NAT REDIRECT
HY2_HOP_RANGE=58888:60888

# ---------------------------------------------------------------- 6. 证书
ACME_PORT=80
# 留空则用 /root/cert/<DOMAIN>
CERT_DIR=

# ---------------------------------------------------------------- 7. Reality
# 借用的外部站点，要求支持 TLS 1.3 + H2，且不要用会被针对性封锁的域名
REALITY_SNI=www.apple.com

# 密钥对留空则部署时用 openssl 现生成（x25519，base64url 43 字符）
REALITY_PRIV=
REALITY_PUB=
REALITY_SID=

# ---------------------------------------------------------------- 8. 节点凭据
# 全部留空则自动生成。想复用已有凭据时填这里。
ANYTLS_PASSWORD=
HY2_PASSWORD=
REALITY_UUID=
# SS2022 的 psk：标准 base64（带 = 填充），长度由 SS_METHOD 决定。
# 留空会自动生成；填了就必须是合法长度，否则核心起不来。
SS_PASSWORD=
# 以下仅 TUIC 启用时使用
TUIC_UUID=
TUIC_PASSWORD=

# ---------------------------------------------------------------- 9. 系统
# 1 = 屏蔽 IPv6，强制代理仅走 IPv4 出口（推荐）
DISABLE_IPV6=1
DNS_SERVERS=8.8.8.8 8.8.4.4 1.1.1.1

# SSH 端口，用于 iptables 白名单
SSH_PORT=22
